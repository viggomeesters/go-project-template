{
  "schema": "go-workflow.repo-local.project.v1",
  "kind": "project",
  "id": "go-project-template",
  "name": "Go Project Template",
  "source_of_truth": "repo-local",
  "contract_version": 2,
  "project_mode": "template",
  "required_stack_version": "0.3.39",
  "stack_ref": "v0.3.39",
  "default_verification": [
    "bash scripts/validate-go.sh"
  ],
  "release_profiles": {
    "template-source-maintenance": {
      "provider": "git-tag",
      "remote": "origin",
      "branch": "main"
    }
  },
  "dependency_projects": {
    "go-workflow-stack": "../go-workflow-stack"
  }
}
